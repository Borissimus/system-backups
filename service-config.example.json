{
  "schema_version": 1,
  "backup_dir": "/media/USER/backup_disk/system-backups",
  "backup_mount": "/media/USER/backup_disk",
  "backup_disk_uuid": "PUT-BACKUP-DISK-UUID-HERE",
  "backup_profile": "/media/USER/backup_disk/system-backups/backup-config.json",
  "schedule": "20:00",
  "retention": {
    "daily": 7,
    "weekly": 4,
    "monthly": 6
  },
  "min_repository_free_gib": 20,
  "restic_password_file": "/etc/system-backup/restic.pass",
  "success_callback": "/usr/local/lib/system-backup/after-success",
  "notice_user": "USER"
}
