# Installed as /etc/system-backup/system-backup.conf by the installer.
# Values are shell assignments: do not put spaces around '='.

# Absolute path to this cloned backup repository on the backup disk.
BACKUP_DIR=/media/borys/backup_img/system-backups

# Root-readable file containing only the Restic repository password.
RESTIC_PASSWORD_FILE=/etc/system-backup/restic.pass

# Retention: keep the newest backup from each of these periods.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Refuse to start if the filesystem containing BACKUP_DIR has less free space.
MIN_REPOSITORY_FREE_GIB=20

# Invoked only after a real successful backup (not after a lock skip).
SUCCESS_CALLBACK=/usr/local/lib/system-backup/after-success
