[Unit]
Description=Incremental system backup to local Restic repository
Documentation=file:///media/borys/backup_img/system-backups/AUTOMATION.md
Wants=network-online.target
After=network-online.target
OnFailure=system-backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/system-backup/run
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
