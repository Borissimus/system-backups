[Unit]
Description=Incremental system backup to local Restic repository
Wants=network-online.target
After=network-online.target
# Mount dependencies are generated by the installer from service.json.
# The committed unit stays portable across machines and backup mount paths.
OnFailure=system-backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/system-backup/run
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
