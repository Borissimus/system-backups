[Unit]
Description=Incremental system backup to local Restic repository
Documentation=file:///media/borys/backup_img/system-backups/AUTOMATION.md
Wants=network-online.target
After=network-online.target
# Pull in the fstab-generated mount when the disk was connected after boot.
# If it is absent, the mount fails after its fstab timeout and OnFailure
# produces the usual shell notice instead of starting against an empty path.
RequiresMountsFor=/media/borys/backup_img
OnFailure=system-backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/system-backup/run
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
